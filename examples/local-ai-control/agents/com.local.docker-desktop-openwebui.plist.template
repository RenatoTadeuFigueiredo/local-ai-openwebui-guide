<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.docker-desktop-openwebui</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/services/open-webui-terminals/start-docker-desktop.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/services/open-webui-mac/logs/docker-desktop.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/services/open-webui-mac/logs/docker-desktop.stderr.log</string>
</dict>
</plist>
