<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.openwebui</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/services/open-webui-mac/app/start-open-webui.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/services/open-webui-mac</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/services/open-webui-mac/logs/openwebui.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/services/open-webui-mac/logs/openwebui.stderr.log</string>
</dict>
</plist>
