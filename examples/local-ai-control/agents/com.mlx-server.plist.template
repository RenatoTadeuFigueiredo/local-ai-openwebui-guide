<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mlx-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/mlx_lm.server</string>
        <string>--model</string>
        <string>__HOME__/Models/Qwen3.6-35B-A3B-8bit</string>
        <string>--port</string>
        <string>8080</string>
        <string>--prompt-cache-bytes</string>
        <string>25769803776</string>
        <string>--max-tokens</string>
        <string>4096</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/assistente-mac/logs/mlx-server.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/assistente-mac/logs/mlx-server.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
