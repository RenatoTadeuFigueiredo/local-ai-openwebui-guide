{
  "uid": "localagent-omlx",
  "title": "LocalAgent \u2014 oMLX (qwen38 + sage-a15)",
  "tags": [
    "localagent",
    "omlx",
    "local-ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
