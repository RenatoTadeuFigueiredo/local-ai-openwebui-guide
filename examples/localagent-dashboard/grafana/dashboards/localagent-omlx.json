    "list": [
      {
        "name": "model",
        "label": "Modelo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-local"
        },
        "query": "label_values(omlx_requests_total, model)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
