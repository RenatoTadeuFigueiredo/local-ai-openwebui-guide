<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.ornith-omlx</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROFILE_ROOT__/launchd-start.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>WorkingDirectory</key>
  <string>__PROFILE_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__PROFILE_ROOT__/state/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROFILE_ROOT__/state/launchd.err.log</string>
</dict>
</plist>